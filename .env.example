# Agency Admin & Session Security (Required in Render Environment — never hardcode in code!)
ADMIN_SECRET=
AUTH_SECRET=

# AI Credentials (Fallback Chain: Gemini 2026 Models -> OpenRouter Free -> Groq Optional)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=

# Persistent Database (MongoDB Atlas M0)
MONGODB_URI=
MONGODB_DB_NAME=whatsapp_bot

# Optional Multi-Tenant Controls (Optimized for Render Free 512 MB RAM)
MAX_ACTIVE_WA_SESSIONS=5
PORT=3000
NODE_ENV=production
