# AI Credentials (Fallback Chain: Groq -> OpenRouter Free -> Gemini Free)
GROQ_API_KEY=gsk_your_groq_api_key_here
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# Persistent Database (Fixes Render Free session wipe! Leave empty on VPS to use local disk)
MONGODB_URI=
MONGODB_DB_NAME=whatsapp_bot
SESSION_ID=default

# Optional Security Tokens
SCAN_SECRET=
BOT_API_SECRET=

# Optional Custom Instructions for the Bot
SYSTEM_PROMPT=You are a smart, professional, and friendly AI assistant on WhatsApp. Answer concisely and clearly with natural formatting and emojis.

# Server Port
PORT=3000
