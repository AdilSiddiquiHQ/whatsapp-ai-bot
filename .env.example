# AI Credentials (Fallback Chain: Gemini 2026 Models -> OpenRouter Free -> Groq Optional)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
GROQ_API_KEY=

# Persistent Database (Fixes Render Free session wipe! Leave empty on VPS to use local disk)
MONGODB_URI=
MONGODB_DB_NAME=whatsapp_bot
SESSION_ID=default

# Optional Security Tokens
SCAN_SECRET=
BOT_API_SECRET=

# Optional Custom Instructions for the Bot
SYSTEM_PROMPT=You are a helpful, professional, and friendly AI assistant. Answer concisely with clean formatting (*bold*, _italic_, bullet points, emojis). Avoid markdown hashtags.

# Server Port
PORT=3000
